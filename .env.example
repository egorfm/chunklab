# Server & App Settings
APP_NAME=ChunkLab
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# Storage
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DB_PATH=./data/chunklab.db

# Qdrant Vector Store
# For local embedded storage leave QDRANT_URL empty or set to :memory: or local path
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./data/qdrant_storage

# Embeddings
# Options: BAAI/bge-m3, intfloat/multilingual-e5-base, sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
